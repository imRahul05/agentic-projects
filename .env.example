# Environment
NODE_ENV=development
PORT=8080
API_BASE_PATH=
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000

# AI Provider Keys
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# AI Model Configuration
AI_DEFAULT_MODEL_ALIAS=default
AI_CLIENT_SELECTABLE_ALIASES=default,fast,reasoning

# Agent Budgets
AGENT_MAX_STEPS=6
AGENT_TOTAL_TIMEOUT_MS=25000
AGENT_STEP_TIMEOUT_MS=10000
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_HISTORY_WINDOW=10
AGENT_MAX_INPUT_CHARS=4000

# Weather Providers
WEATHER_PROVIDER=open-meteo
WEATHER_FALLBACK_PROVIDERS=mock
WEATHER_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_OPEN_METEO_TIMEOUT_MS=7000
WEATHER_WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
WEATHER_API_KEY=
WEATHER_WEATHERAPI_TIMEOUT_MS=7000

# Weather Defaults
WEATHER_DEFAULT_UNITS=metric
WEATHER_DEFAULT_FORECAST_DAYS=5
WEATHER_MAX_FORECAST_DAYS=7
WEATHER_GEOCODE_LIMIT=5
WEATHER_LOCALE=en-US

# Cache
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=500
CACHE_TTL_GEOCODE_MS=86400000
CACHE_TTL_CURRENT_MS=600000
CACHE_TTL_FORECAST_MS=1800000
CACHE_TTL_ALERTS_MS=300000
CACHE_TTL_HISTORY_MS=86400000

# Rate Limits
RATE_LIMIT_CHAT_WINDOW_MS=60000
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_READ_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=100

# Observability
LOG_LEVEL=info
TELEMETRY_ENABLED=false
SERVICE_NAME=weather-ai-agent
