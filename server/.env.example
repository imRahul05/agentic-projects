# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
API_BASE_PATH=/api
CORS_ORIGINS=http://localhost:3000
# true | false | number of proxy hops
TRUST_PROXY=false
BODY_LIMIT_BYTES=262144
# Must be >= AGENT_TOTAL_TIMEOUT_MS, or streams get cut off mid-answer.
REQUEST_TIMEOUT_MS=90000

# ─── Model providers ──────────────────────────────────────────────────────────
# At least one key is required. A provider without a key is not registered,
# is absent from /api/capabilities, and is rejected if a client requests it.
OPENAI_API_KEY=
# OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# ─── Models ───────────────────────────────────────────────────────────────────
# REQUIRED. Aliases are the only model identifier that crosses the wire, so no
# model id is ever hardcoded in application code. Every `provider` here must
# have credentials above. Replace the model ids with the ones you intend to use.
AI_MODEL_ALIASES={"default":{"provider":"anthropic","model":"claude-sonnet-5","label":"Balanced","description":"Default weather answers with web search"},"fast":{"provider":"anthropic","model":"claude-haiku-4-5-20251001","label":"Fast","description":"Lowest latency"}}
AI_DEFAULT_MODEL_ALIAS=default
# Aliases the browser may choose from. Empty means "all defined aliases".
AI_CLIENT_SELECTABLE_ALIASES=default,fast

# ─── Agent budgets (the real cost controls — there is no auth) ─────────────────
AGENT_MAX_STEPS=5
AGENT_MAX_SEARCHES=3
AGENT_TOTAL_TIMEOUT_MS=60000
AGENT_STEP_TIMEOUT_MS=30000
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_HISTORY_WINDOW=10
AGENT_MAX_INPUT_CHARS=4000

# ─── Web search ───────────────────────────────────────────────────────────────
# native   = the model provider runs and cites the search (no extra key, default)
# external = our own tool over a search API (portable across providers, testable)
SEARCH_MODE=native

# Required when SEARCH_MODE=native, one entry per configured provider.
# Providers ship dated tool versions, so these live in config, not in code.
SEARCH_NATIVE_TOOL_IDS={"openai":"webSearch","anthropic":"webSearch_20260318"}
SEARCH_MAX_USES=3
# Optional quality lever: restrict search to trusted weather sources.
SEARCH_ALLOWED_DOMAINS=
SEARCH_BLOCKED_DOMAINS=
# Optional geographic bias for ambiguous place names.
# SEARCH_USER_LOCATION={"country":"PT","timezone":"Europe/Lisbon"}

# Used only when SEARCH_MODE=external.
SEARCH_CLIENT=fake
SEARCH_API_KEY=
# SEARCH_BASE_URL=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_MS=10000
SEARCH_CACHE_TTL_MS=300000

# ─── Cache (external search mode only — weather answers are never cached) ──────
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=500

# ─── Rate limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_CHAT_WINDOW_MS=60000
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_READ_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=120

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
TELEMETRY_ENABLED=false
SERVICE_NAME=weather-agent

# ─── Chat UI (served via /api/capabilities so the client hardcodes nothing) ────
CHAT_SUGGESTIONS=What's the weather in Lisbon right now?|Will it rain in Tokyo tomorrow?|Do I need a jacket in Berlin today?
CHAT_DEFAULT_LOCALE=en-US

# ─── Feature flags ────────────────────────────────────────────────────────────
# FEATURE_FLAGS={"showSources":true}
