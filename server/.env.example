# ─────────────────────────────────────────────────────────────────────────────
# Secrets and infrastructure ONLY.
#
# Model ids, provider identity, native web-search tool versions, agent budgets
# and chat copy live in version control, not here:
#
#   src/config/ai-models.config.ts   the MODELS table and DEFAULT_MODEL
#   src/config/ai.constants.ts       provider ids, tool name + versions, budgets
#
# To add or change a model, edit the MODELS table — one line per model, and the
# provider is inferred from the model id. Never set model ids here.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Provider credentials ─────────────────────────────────────────────────────
# The default model is an OpenAI one, so OPENAI_API_KEY is required.
# ANTHROPIC_API_KEY is optional: add it and the Claude models in the MODELS
# table become selectable too. Models whose provider has no key are simply not
# offered, rather than blocking startup.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# ─── Search credentials ───────────────────────────────────────────────────────
# Only needed when SEARCH_DEFAULTS.mode in src/config/ai.constants.ts is
# `external`. The default `native` mode uses the model provider's own web
# search and needs no extra key.
SEARCH_API_KEY=
# SEARCH_BASE_URL=

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
API_BASE_PATH=/api
CORS_ORIGINS=http://localhost:3000
# true | false | number of proxy hops
TRUST_PROXY=false
BODY_LIMIT_BYTES=262144
# Must be >= AGENT_DEFAULTS.totalTimeoutMs, or streams are cut off mid-answer.
REQUEST_TIMEOUT_MS=90000

# ─── Cache (external search mode only — weather answers are never cached) ──────
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=500

# ─── Rate limits (the real abuse control — there is no auth) ──────────────────
RATE_LIMIT_CHAT_WINDOW_MS=60000
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_READ_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=120

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
TELEMETRY_ENABLED=false
SERVICE_NAME=weather-agent
